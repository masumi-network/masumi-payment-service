# Copy this file to security.env and fill it in. security.env is git-ignored.
# One KEY=value per line, no spaces around "=", no comments after a value.
# Wrap a value in quotes if it has spaces. Values already set in the environment win.

# ---- GitHub ----
# A classic token with the scopes "repo" and "read:org", created by an org owner
# (or a security manager). If the org uses SAML SSO, authorize the token for it.
GH_TOKEN=
# The script always covers the masumi-network organisation.
# Optional: only these repositories, or all except these (comma separated names)
#REPOS_ONLY=
#REPOS_EXCLUDE=

# ---- Email (needed for "report") ----
# Gmail: use an app password, not the account password.
MAIL_SMTP_URL=smtps://smtp.gmail.com:465
MAIL_USER=
MAIL_PASSWORD=
# Optional, defaults to MAIL_USER. A plain address.
#MAIL_FROM=
# One or more addresses, comma separated
MAIL_TO=
