    "smart_wallet/types/Datum": {
      "title": "Datum",
      "description": "Inline datum of the single wallet UTxO — the one carrying the state token.\n\n `limit` and `spent_in_period` must list exactly the same assets in the same\n order. The spend path enforces it, which is what makes the counter update a\n deterministic map rather than an insertion with an ordering question.",
      "anyOf": [
        {
          "title": "Datum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "agent",
              "description": "The delegated hot key. One agent per wallet; a second agent means a\n second wallet. Lives here rather than in the parameters so a compromised\n hot key can be rotated without changing the address.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "limit",
              "description": "Maximum each asset may move out per period. An asset absent from this\n list is frozen: it can neither leave nor be added.\n\n **Lovelace must be listed** — policy `#\"\"`, name `#\"\"` — or the wallet is\n unusable: a spend moves lovelace even when it only pays the fee, and a\n deposit of ADA is a movement of an unlisted asset. Nothing on-chain checks\n this, by the same decision that leaves the quorum configuration\n unguarded; deployment tooling owns it.",
              "$ref": "#/definitions/smart_wallet~1types~1AssetValue"
            },
            {
              "title": "period_length",
              "description": "Length of the accounting window, in milliseconds.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "period_start",
              "description": "Start of the window `spent_in_period` is accounted against.",
              "$ref": "#/definitions/smart_wallet~1types~1POSIXTime"
            },
            {
              "title": "spent_in_period",
              "description": "Moved out so far inside the current window, per asset.",
              "$ref": "#/definitions/smart_wallet~1types~1AssetValue"
            },
            {
              "title": "min_balance_lovelace",
              "description": "Lovelace floor an agent spend may not breach, so the wallet keeps a\n reserve and the UTxO stays above the ledger's minimum. The owner is not\n bound by it.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
