{
  "name": "admin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"if (!(process.env.npm_config_user_agent||'').startsWith('pnpm')) { console.error('\\nThis project uses pnpm. Use: pnpm install\\n'); process.exit(1); }\"",
    "dev": "next dev",
    "predev": "node scripts/copy-monaco.mjs",
    "prebuild": "node scripts/copy-monaco.mjs",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test $(find src -type f -name '*.test.ts')",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi-ts": "openapi-ts && node --import tsx scripts/patch-report-export-response-types.ts",
    "openapi-ts-latest": "cp ./../src/utils/generator/swagger-generator/openapi-docs.json ./openapi-docs.json && pnpm run openapi-ts"
  },
  "dependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@hookform/resolvers": "5.4.0",
    "@meshsdk/core": "1.9.0-beta.96",
    "@monaco-editor/loader": "1.7.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "axios": "1.21.1",
    "canonical-json": "0.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "0.562.0",
    "lz-string": "1.5.0",
    "masumi-schema-validator-component": "1.2.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-icons": "5.7.0",
    "react-toastify": "11.2.0",
    "recharts": "3.10.1",
    "sass": "1.108.2",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/lz-string": "1.5.0",
    "@types/node": "25.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "postcss": "8.5.33",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
