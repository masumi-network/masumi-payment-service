#!/bin/bash
# Keep the Hydra Host peer plane behind a verified nftables ruleset.
#
# The peer plane is unauthenticated etcd raft. The Host reports its allow-list
# at GET /v1/peer-allowlist but cannot apply it, so this script runs on the
# machine, as root, outside the container. It renders nftables commands locally.
#
#   baseline  Load a ruleset that refuses the whole peer range, then verify it.
#             Run before the Host starts, so no accept rule from an earlier run
#             survives a restart.
#   refresh   Fetch the allow-list, check it, apply it, verify it, then tell the
#             Host which ruleset is loaded. Run on a timer and after every
#             membership change.
#   verify    Exit 0 only if the loaded ruleset refuses the peer range on both
#             the input and forward hooks. Prints "verified" on success.
#
# Settings come from /etc/default/hydra-peer-firewall, or the environment:
#   HYDRA_PEER_PORT_START   first peer port (default 5001)
#   HYDRA_PEER_PORT_COUNT   number of peer ports (default 32)
#   HYDRA_ADMIN_TOKEN_FILE  root-owned file holding the admin token (refresh)
#   HYDRA_CONTROL_SOCKET    private Unix socket shared with the Host (refresh)
#   HYDRA_CONTROL_SOCKET_UID  expected Host uid (default 10001)
#   HYDRA_PEER_RULES_FILE   persisted ruleset (default /etc/nftables.d/hydra-peer.nft)
#   HYDRA_PEER_LOCK_FILE    lock file (default /run/hydra-peer-firewall.lock)
set -euo pipefail
umask 077

CONFIG_FILE=${HYDRA_PEER_FIREWALL_CONFIG:-/etc/default/hydra-peer-firewall}
if [[ -r "$CONFIG_FILE" ]]; then
	# shellcheck source=/dev/null
	source "$CONFIG_FILE"
fi

START=${HYDRA_PEER_PORT_START:-5001}
COUNT=${HYDRA_PEER_PORT_COUNT:-32}
CONTROL_SOCKET=${HYDRA_CONTROL_SOCKET:-}
CONTROL_SOCKET_UID=${HYDRA_CONTROL_SOCKET_UID:-10001}
DEST=${HYDRA_PEER_RULES_FILE:-/etc/nftables.d/hydra-peer.nft}
LOCK=${HYDRA_PEER_LOCK_FILE:-/run/hydra-peer-firewall.lock}
TABLE='inet hydra_peer'

fail() {
	echo "hydra-peer-firewall: $*" >&2
	exit 1
}

# No leading zeros: $(( )) would read 05001 as octal and refuse the wrong range.
[[ "$START" =~ ^[1-9][0-9]*$ && "$COUNT" =~ ^[1-9][0-9]*$ ]] || fail 'peer port start and count must be positive integers'
LAST=$((START + COUNT - 1))
((START >= 1 && COUNT >= 1 && LAST <= 65535)) || fail "peer port range $START+$COUNT is invalid"
# nft rejects a zero-size interval such as 5001-5001.
if ((START == LAST)); then
	RANGE="$START"
else
	RANGE="$START-$LAST"
fi
TMP="$DEST.new"
RESPONSE="$DEST.response"

render_baseline() {
	local hook
	echo '#!/usr/sbin/nft -f'
	echo '# Written by hydra-peer-firewall baseline. Refuses the whole peer range.'
	echo "add table $TABLE"
	echo "flush table $TABLE"
	echo "table $TABLE {"
	for hook in input forward; do
		echo "	chain $hook {"
		echo "		type filter hook $hook priority filter; policy accept;"
		echo "		tcp dport $RANGE drop"
		echo '	}'
	done
	echo '}'
}

# A fetch cut off after `add table` + `flush table` is valid syntax that opens
# the range. Require the drop rule on both hooks and the closing brace.
check_ruleset_file() {
	[[ -s "$TMP" ]] || fail 'the new ruleset is empty'
	[[ "$(grep -cE "^[[:space:]]*tcp dport $RANGE drop$" "$TMP")" == 2 ]] ||
		fail "the new ruleset does not refuse $RANGE on exactly two hooks"
	[[ "$(grep -vE '^[[:space:]]*$' "$TMP" | tail -n 1)" == '}' ]] || fail 'the new ruleset is truncated'
}

# The only shapes the Host renders. nft lists a one-element set as a plain
# address, so both forms are allowed.
ACCEPT_RULE='^tcp dport [0-9]+ ip saddr (\{ [0-9.]+(, [0-9.]+)* \}|[0-9.]+) accept$'

# A drop rule alone is not enough: an earlier broad accept would make it dead.
# Require the drop to be the last rule and every other rule to be a
# source-scoped accept. No `grep -q` in a pipeline here: under pipefail its
# early exit can fail the pipeline and turn a match into a pass.
verify_loaded() {
	local hook chain rules bad
	for hook in input forward; do
		chain=$(nft list chain $TABLE "$hook" 2>/dev/null) || fail "table $TABLE has no $hook chain loaded"
		grep -qE "type filter hook $hook " <<<"$chain" || fail "chain $hook is not on the $hook hook"
		rules=$(grep -vE '^[[:space:]]*(table |chain |type |}|#|$)' <<<"$chain" | sed -E 's/^[[:space:]]+//' || true)
		[[ "$(tail -n 1 <<<"$rules")" == "tcp dport $RANGE drop" ]] ||
			fail "chain $hook does not end by refusing $RANGE"
		bad=$(sed '$d' <<<"$rules" | grep -vE "$ACCEPT_RULE" || true)
		[[ -z "$bad" ]] || fail "chain $hook has a rule other than a source-scoped accept: ${bad%%$'\n'*}"
	done
}

# Check, persist, apply, verify. The persisted copy is what nftables.service
# loads at boot or reload.
install_ruleset() {
	check_ruleset_file "$TMP"
	nft -c -f "$TMP" || fail 'nft rejected the ruleset'
	mv "$TMP" "$DEST"
	nft -f "$DEST" || fail 'nft failed to apply the ruleset'
	verify_loaded
}

# The temporary files sit next to $DEST, so a wide nftables include glob could
# load a rejected one at the next boot. Remove them on every exit.
with_lock() {
	exec 9>"$LOCK"
	flock 9
	trap 'rm -f "$TMP" "$RESPONSE"' EXIT
	mkdir -p "$(dirname "$DEST")"
	"$@"
}

do_baseline() {
	render_baseline >"$TMP"
	install_ruleset
}

# Call the private Control Plane socket as admin. The public TCP listener is
# never a fallback: another local process can own that port while Host is down.
# printf is a builtin, so the token never appears in a process argv.
control_curl() {
	local token_file=$1
	shift
	printf 'Authorization: Bearer %s\n' "$(tr -d '\r\n' <"$token_file")" |
		curl -fsS --max-time 20 --noproxy '*' --unix-socket "$CONTROL_SOCKET" -H @- "$@"
}

check_control_socket() {
	[[ "$CONTROL_SOCKET_UID" =~ ^[0-9]+$ ]] || fail 'HYDRA_CONTROL_SOCKET_UID must be a numeric uid'
	python3 -c '
import os, stat, sys

path, expected_uid = sys.argv[1], int(sys.argv[2])
if not os.path.isabs(path) or os.path.normpath(path) != path:
    sys.exit("the control socket path must be absolute and normalized")
try:
    directory = os.lstat(os.path.dirname(path))
    endpoint = os.lstat(path)
except OSError as error:
    sys.exit("the private control socket is unavailable: %s" % error)
if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != expected_uid:
    sys.exit("the control socket directory has the wrong type or owner")
if stat.S_IMODE(directory.st_mode) & 0o077 or stat.S_IMODE(directory.st_mode) & 0o700 != 0o700:
    sys.exit("the control socket directory must have mode 0700")
if not stat.S_ISSOCK(endpoint.st_mode) or endpoint.st_uid != expected_uid:
    sys.exit("the control socket has the wrong type or owner")
ancestor = os.path.dirname(path)
while True:
    try:
        current = os.lstat(ancestor)
    except OSError as error:
        sys.exit("the control socket ancestor is unavailable: %s" % error)
    if not stat.S_ISDIR(current.st_mode) or current.st_uid not in (0, expected_uid):
        sys.exit("the control socket has an untrusted ancestor")
    mode = stat.S_IMODE(current.st_mode)
    if mode & 0o022 and not (current.st_uid == 0 and mode & stat.S_ISVTX):
        sys.exit("the control socket has a writable ancestor")
    if ancestor == "/":
        break
    ancestor = os.path.dirname(ancestor)
' "$CONTROL_SOCKET" "$CONTROL_SOCKET_UID" || fail 'refusing to send the admin token to an untrusted control socket'
}

do_refresh() {
	local token_file=${HYDRA_ADMIN_TOKEN_FILE:-}
	[[ -n "$token_file" && -s "$token_file" ]] || fail 'HYDRA_ADMIN_TOKEN_FILE must name a non-empty file'
	[[ -n "$CONTROL_SOCKET" ]] || fail 'HYDRA_CONTROL_SOCKET must name the private Host Unix socket'
	[[ -z "${HYDRA_CONTROL_URL:-}" ]] || fail 'HYDRA_CONTROL_URL is unsupported; use HYDRA_CONTROL_SOCKET'
	check_control_socket

	if ! control_curl "$token_file" 'http://localhost/v1/peer-allowlist' >"$RESPONSE"; then
		fail 'could not fetch the peer allow-list; the loaded ruleset is unchanged'
	fi

	# Build nftables commands from typed ports and IPv4 addresses. The response's
	# nftables field is never executable input to this root process.
	if ! python3 -c '
import ipaddress, json, sys

body = json.load(open(sys.argv[1]))
start, count = int(sys.argv[2]), int(sys.argv[3])
peer_range = body["peerRange"]
if type(peer_range["start"]) is not int or type(peer_range["count"]) is not int:
    sys.exit("Host peer range is invalid")
if peer_range["start"] != start or peer_range["count"] != count:
    sys.exit("Host peer range %s+%s does not match %s+%s" % (peer_range["start"], peer_range["count"], start, count))

rules = body["rules"]
if not isinstance(rules, list) or len(rules) > count:
    sys.exit("Host peer rules are invalid")
allowed = {}
for rule in rules:
    port = rule["peerPort"]
    addresses = rule["allowedIpv4Addresses"]
    if type(port) is not int or port < start or port >= start + count or port in allowed:
        sys.exit("Host peer port is invalid or duplicated")
    if not isinstance(addresses, list) or any(not isinstance(address, str) for address in addresses):
        sys.exit("Host peer addresses are invalid")
    if type(rule["closed"]) is not bool or rule["closed"] != (len(addresses) == 0):
        sys.exit("Host peer closed state is inconsistent")
    try:
        allowed[port] = sorted({str(ipaddress.IPv4Address(address)) for address in addresses})
    except ipaddress.AddressValueError:
        sys.exit("Host peer address is not IPv4")
    for error in rule.get("resolutionErrors", []):
        print("hydra-peer-firewall: %s: %s: %s" % (rule["nodeId"], error["host"], error["reason"]), file=sys.stderr)

last = start + count - 1
port_range = str(start) if start == last else "%s-%s" % (start, last)
print("#!/usr/sbin/nft -f")
print("# Rendered by hydra-peer-firewall from validated peer addresses.")
print("add table inet hydra_peer")
print("flush table inet hydra_peer")
print("table inet hydra_peer {")
for hook in ("input", "forward"):
    print("\tchain %s {" % hook)
    print("\t\ttype filter hook %s priority filter; policy accept;" % hook)
    for port, addresses in sorted(allowed.items()):
        if addresses:
            print("\t\ttcp dport %s ip saddr { %s } accept" % (port, ", ".join(addresses)))
    print("\t\ttcp dport %s drop" % port_range)
    print("\t}")
print("}")
' "$RESPONSE" "$START" "$COUNT" >"$TMP"; then
		fail 'the peer allow-list response is invalid; the loaded ruleset is unchanged'
	fi
	install_ruleset
	acknowledge "$token_file"
}

# The Host keeps a released peer port out of use until it hears that a ruleset
# without that port's old peers is loaded. Only after verify_loaded passes.
acknowledge() {
	local generation
	generation=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("generation", ""))' "$RESPONSE") ||
		fail 'could not read the generation; the ruleset is applied, but released peer ports stay blocked'
	# A Host older than this script sends none, and holds no port for one.
	if [[ -z "$generation" ]]; then
		echo 'hydra-peer-firewall: the Host sends no generation, so there is nothing to acknowledge' >&2
		return
	fi
	[[ "$generation" =~ ^[0-9a-f-]+\.[0-9]+$ ]] ||
		fail 'the peer allow-list generation is malformed; the ruleset is applied, but released peer ports stay blocked'
	if ! control_curl "$1" -H 'Content-Type: application/json' \
		--data-binary "{\"generation\":\"$generation\"}" 'http://localhost/v1/peer-allowlist/applied' >/dev/null; then
		fail 'the ruleset is applied and verified, but the Host did not record it; released peer ports stay blocked'
	fi
}

case "${1:-}" in
baseline) with_lock do_baseline ;;
refresh) with_lock do_refresh ;;
verify) verify_loaded ;;
*) fail 'usage: hydra-peer-firewall baseline|refresh|verify' ;;
esac
echo verified
