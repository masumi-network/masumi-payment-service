/// The local participant — this server's wallet and Hydra node config.
/// Can exist before any head (hydraHeadId is nullable).
/// Once assigned to a head, the @unique constraint ensures one local participant per head.
/// Has full key material for signing transactions.
model HydraLocalParticipant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Which head this participant belongs to (nullable — can be created before a head exists)
  hydraHeadId String?    @unique
  HydraHead   HydraHead? @relation(fields: [hydraHeadId], references: [id], onDelete: Cascade)

  /// The HotWallet this participant operates with (has secret mnemonic). This is
  /// the FUNDING wallet — the source of the buyer's committed escrow funds — NOT
  /// the head's on-chain identity (see cardanoVkey).
  walletId String
  Wallet   HotWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  /// The Hydra NODE's own Cardano verification-key HASH (28-byte hex). This is the
  /// on-chain participant identity: Hydra mints the InitTx participant token for
  /// this key and head verification checks the token against it. It is
  /// deliberately SEPARATE from the funding HotWallet (walletId) so the node's
  /// infrastructure key is never the custodial fund wallet — a node-host
  /// compromise cannot reach escrowed funds, and node keys rotate independently.
  /// (Set to the funding wallet's vkey only for legacy coupled heads.)
  cardanoVkey String

  /// Whether this service keeps the node's L1 fuel topped up from `walletId`.
  /// False when the operator said they would fund the node key themselves: the
  /// scheduled funding cycle then leaves it alone, and so does redemption.
  /// Without this the documented opt-out did nothing — the cycle funds any node
  /// held by a live invite or a non-final head, so 30 ADA left the wallet within
  /// one tick of an invite that had asked us not to.
  autoFund Boolean @default(true)

  /// Optional lifetime funding limit in lovelace. Null keeps automatic funding unlimited.
  /// Pending and confirmed transfers to the node address count toward this limit.
  automaticFundingLimitLovelace BigInt?

  /// The Hydra Host this participant's node runs on. Required: every node is
  /// provisioned through a Host, which generates its keys and supervises its
  /// process — a node configured by hand is not representable. Restrict: a Host
  /// with live participants must not be deleted.
  hydraHostId String
  HydraHost   HydraHost @relation(fields: [hydraHostId], references: [id], onDelete: Restrict)

  /// Node id assigned by that Host. Together with hydraHostId this identifies
  /// the supervised process; nodeUrl/nodeHttpUrl below are derived from the two.
  /// Unique per Host: two participants pointing at one supervised node would
  /// have them fighting over the same head state.
  hostNodeId String

  /// WebSocket URL for this participant's Hydra node, through its Host's proxy
  /// (wss://host/v1/nodes/<hostNodeId>/api). Derived from hydraHostId and
  /// hostNodeId, and stored so the connection manager does not have to resolve
  /// the Host on every reconnect.
  nodeUrl String

  /// HTTP URL for the same node, through the same proxy.
  nodeHttpUrl String

  /// Whether this participant has committed funds to the head
  hasCommitted Boolean @default(false)

  /// L1 commit transaction hash (set after this participant commits to the head)
  commitTxHash String?

  /// Signed invalid-hereafter slot retained with the L1 commit hash. A retry is
  /// safe only after this slot plus the rollback/indexer grace window has passed
  /// with the hash absent. Legacy already-confirmed rows are migrated with 0.
  commitInvalidHereafterSlot BigInt?

  /// When this participant's signing keys were handed to an operator to back
  /// up. Set by the one-time reveal and never cleared: the disclosure path
  /// seals after the first use, mirroring the Host's own escrow so key material
  /// cannot be pulled repeatedly out of the database through the API.
  keysDisclosedAt DateTime?

  /// Encrypted Hydra signing key (1:1)
  hydraSecretKeyId String         @unique
  HydraSecretKey   HydraSecretKey @relation(fields: [hydraSecretKeyId], references: [id], onDelete: Restrict)

  /// Incremental-commit top-ups performed by this participant
  Topups HydraTopup[]

  /// Incremental-decommit withdrawals performed by this participant
  Withdrawals HydraDecommit[]

  /// Low in-head-balance monitoring rules for this participant
  LowBalanceRules HydraLowBalanceRule[]

  @@unique([hydraHostId, hostNodeId])
  @@index([walletId])
  @@index([hasCommitted, updatedAt])
}
