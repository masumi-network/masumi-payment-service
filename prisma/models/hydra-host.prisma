/// Status of a Hydra Host deployment.
enum HydraHostStatus {
  /// Accepting new node placements.
  Active
  /// Reachable and serving existing heads, but no new placements.
  Draining
  /// Health checks are failing; existing heads keep their placement because a
  /// head cannot be moved (its persistence directory is not relocatable).
  Unreachable
  /// Administratively disabled.
  Disabled
}

/// A deployment that supervises hydra-node processes and exposes a token-gated
/// control plane. Several Hosts may serve one payment service; a head is placed
/// on exactly one Host at provisioning time and stays there for its whole life,
/// because its persistence directory holds the only copy of the head state on
/// that machine and cannot be moved.
model HydraHost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Operator-facing label.
  name    String
  network Network

  /// Base URL of the Host control plane, e.g. https://hydra1.example.com.
  /// Prefer TLS terminated in front of the Host. Plain HTTP requires the
  /// explicit allowInsecureHttp opt-in below.
  baseUrl String

  /// Explicit operator opt-in for sending bearer tokens to an HTTP Host URL.
  /// Intended for loopback or a separately secured private network only.
  allowInsecureHttp Boolean @default(false)

  /// Hostname the Host advertises for per-head peer ports. Recorded so the
  /// counterparty handshake can be checked against what the Host actually
  /// returns — etcd rejects a mismatch between advertised and cluster URLs.
  publicPeerHost String

  /// Encrypted admin token. Fleet operations only: provision, escrow-ack,
  /// reconfigure, delete. Nullable so a Host may be registered for runtime use
  /// without handing this service the ability to provision on it.
  encryptedAdminToken String?

  /// Encrypted user token. Runtime access to the proxied node API.
  encryptedUserToken String

  /// Last values reported by GET /v1/capabilities. Provisioning is refused when
  /// these do not match what this service expects, so a version skew fails at
  /// placement rather than at first commit.
  hydraVersion        String?
  scriptCatalogueHash String?
  ledgerParamsHash    String?

  /// Port this Host serves its Exchange Plane on, as the Host itself reports it.
  ///
  /// A property of the Host, not of this service: an invite's redemption URL is
  /// built from it, so assuming one fleet-wide value sends counterparties to a
  /// Host that never issued the nonce — which they see as a 404 and cannot act
  /// on. Null until the first capabilities probe fills it in.
  exchangePort Int?

  status          HydraHostStatus @default(Active)
  lastHealthAt    DateTime?
  lastHealthError String?

  /// Set while an operator has paused this Host for maintenance, such as a
  /// redeploy. While set, the service starts no new work on its heads and takes
  /// no new placements. Work already in flight finishes first; then the nodes
  /// are stopped, so no transaction can happen on these heads at all.
  pausedAt             DateTime?
  /// Host node ids this pause stops, fixed in the same write that sets
  /// `pausedAt`. Resume starts exactly these and no other node.
  pausedNodeIds        String[]  @default([])
  /// When every node in `pausedNodeIds` was asked to stop. Null while the pause
  /// still waits for in-flight work.
  pauseStopRequestedAt DateTime?
  /// Held while one instance stops or starts this Host's nodes, so a Resume
  /// and an advance never act at once. Expires on its own if the holder dies.
  pauseLeaseUntil      DateTime?

  Participants     HydraLocalParticipant[]
  HydraHeadInvites HydraHeadInvite[]

  @@unique([network, baseUrl])
  /// Placement scans for an Active Host on a given network.
  @@index([network, status])
}
